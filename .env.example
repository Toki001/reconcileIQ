# Template only. Run python3 scripts/setup_env.py to generate local credentials.
# This milestone supports local/test environments only. Never use real financial data.
RECONCILE_ENVIRONMENT=local
RECONCILE_DATABASE_URL=sqlite:///.data/reconcileiq.db
RECONCILE_INFRASTRUCTURE_REQUIRED=false
RECONCILE_BROKER_URL=amqp://reconcile:REPLACE_ME@127.0.0.1:5672//
RECONCILE_MINIO_ENDPOINT=http://127.0.0.1:9100
POSTGRES_USER=reconcile
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=reconcileiq
POSTGRES_PORT=15432
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
WEB_PORT=3100
RABBITMQ_DEFAULT_USER=reconcile
RABBITMQ_DEFAULT_PASS=REPLACE_ME
MINIO_ROOT_USER=reconcile-local
MINIO_ROOT_PASSWORD=REPLACE_ME
API_BASE_URL=http://127.0.0.1:8000

# Generated by setup_env.py; use independent random values of at least 32 characters.
RECONCILE_ADMIN_TOKEN=REPLACE_WITH_RANDOM_SECRET
RECONCILE_REVIEWER_TOKEN=REPLACE_WITH_RANDOM_SECRET
RECONCILE_AUDITOR_TOKEN=REPLACE_WITH_RANDOM_SECRET
RECONCILE_CURSOR_SECRET=REPLACE_WITH_RANDOM_SECRET
RECONCILE_SUPPLIER_WEBHOOKS={"local-supplier":{"organization_id":"demo","secret":"REPLACE_WITH_RANDOM_SECRET"}}
RECONCILE_MINIO_ACCESS_KEY=REPLACE_ME
RECONCILE_MINIO_SECRET_KEY=REPLACE_ME
RECONCILE_MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9100
RECONCILE_MINIO_BUCKET=invoices

# Local worker controls. Compose enables workers; host workers require a matching PostgreSQL URL.
RECONCILE_WORKER_ENABLED=false
RECONCILE_WORKER_CONCURRENCY=4
RECONCILE_WORKER_LEASE_SECONDS=120
RECONCILE_DISPATCH_INTERVAL_SECONDS=2
RECONCILE_DISPATCH_BATCH_SIZE=25
RECONCILE_DISPATCH_VISIBILITY_SECONDS=180
RECONCILE_ADMITTED_JOB_LIMIT=500
RECONCILE_RETRY_BASE_SECONDS=5
RECONCILE_RETRY_MAX_SECONDS=300

# Backend-only Gemini configuration. Disabled until project/key/billing/quota/model checks pass.
# Never use real or confidential documents with Free Tier. No paid fallback.
RECONCILE_AI_ENABLED=false
RECONCILE_AI_API_KEY=
RECONCILE_AI_PROJECT_ID=
RECONCILE_AI_MODEL=gemini-3.5-flash-lite
RECONCILE_AI_ENDPOINT=https://generativelanguage.googleapis.com
RECONCILE_AI_REQUESTS_PER_MINUTE=2
RECONCILE_AI_REQUESTS_PER_DAY=20
RECONCILE_AI_CONCURRENCY=1
RECONCILE_AI_MAX_INPUT_CHARACTERS=20000
RECONCILE_AI_MAX_INPUT_TOKENS=6000
RECONCILE_AI_MAX_OUTPUT_TOKENS=8192
RECONCILE_AI_TIMEOUT_SECONDS=20
# Optional, backend-only ADC file for read-only Cloud project verification. Never commit it.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/readonly-credentials.json
RECONCILE_OCR_ENABLED=false
# Independent random 32-byte hex key generated by setup_env.py; never NEXT_PUBLIC_.
RECONCILE_WEB_SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX_SECRET

# Separate private release rehearsal (compose.release.yml). Production identity is unsupported.
# Leave unset: production mode fails closed. Set local ONLY in a private disposable rehearsal.
# RECONCILE_RELEASE_ENVIRONMENT=local
RECONCILE_RELEASE_WEB_PORT=13100
# Replace these local build tags with reviewed GHCR digest references after release approval.
RECONCILE_API_IMAGE=reconcileiq-api:release-local
RECONCILE_WORKER_IMAGE=reconcileiq-worker:release-local
RECONCILE_WEB_IMAGE=reconcileiq-web:release-local
RECONCILE_MINIO_IMAGE=reconcileiq-minio:local
