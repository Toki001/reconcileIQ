# Template only. Run python3 scripts/setup_env.py to generate local credentials.
# This milestone supports local/test environments only. Never use real financial data.
RECONCILE_ENVIRONMENT=local
RECONCILE_DATABASE_URL=sqlite:///.data/reconcileiq.db
RECONCILE_INFRASTRUCTURE_REQUIRED=false
RECONCILE_BROKER_URL=amqp://reconcile:REPLACE_ME@127.0.0.1:5672//
RECONCILE_MINIO_ENDPOINT=http://127.0.0.1:9100
POSTGRES_USER=reconcile
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=reconcileiq
POSTGRES_PORT=15432
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
WEB_PORT=3100
RABBITMQ_DEFAULT_USER=reconcile
RABBITMQ_DEFAULT_PASS=REPLACE_ME
MINIO_ROOT_USER=reconcile-local
MINIO_ROOT_PASSWORD=REPLACE_ME
API_BASE_URL=http://127.0.0.1:8000

# Generated by setup_env.py; use independent random values of at least 32 characters.
RECONCILE_ADMIN_TOKEN=REPLACE_WITH_RANDOM_SECRET
RECONCILE_REVIEWER_TOKEN=REPLACE_WITH_RANDOM_SECRET
RECONCILE_AUDITOR_TOKEN=REPLACE_WITH_RANDOM_SECRET
RECONCILE_CURSOR_SECRET=REPLACE_WITH_RANDOM_SECRET
RECONCILE_SUPPLIER_WEBHOOKS={"local-supplier":{"organization_id":"demo","secret":"REPLACE_WITH_RANDOM_SECRET"}}
RECONCILE_MINIO_ACCESS_KEY=REPLACE_ME
RECONCILE_MINIO_SECRET_KEY=REPLACE_ME
RECONCILE_MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9100
RECONCILE_MINIO_BUCKET=invoices
